# --- Runtime / generated ---
logs/
current-tunnel-url.txt
cloudflared/*.log
*.log

# --- Local backups (kept out of history; they duplicate the tree) ---
backups/

# --- Laravel app: dependencies, secrets, build artifacts, runtime storage ---
application/vendor/
application/node_modules/
application/.env
application/.env.backup
application/.env.production
application/public/build/
application/public/hot
application/public/storage
application/storage/*.key
application/storage/pail/
# NOTE: don't ignore storage/framework/{views,sessions,cache} or storage/logs
# here. Git cannot track an empty directory, so excluding the folder means a
# fresh clone has no storage/framework/views — and Blade cannot compile a
# template without it, which makes every page 500 on first run. Laravel ships a
# .gitignore inside each of those folders ("*" plus "!.gitignore") that keeps
# the folder while ignoring whatever lands in it, which is what we rely on.
application/.phpunit.result.cache
application/.phpunit.cache/

# --- Editor / OS noise ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# Cloudflare tunnel binary (52MB, downloadable — never track it)
cloudflared/cloudflared.exe
