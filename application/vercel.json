{
  "regions": ["bom1"],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/(css|js|build|storage)/(.*)", "dest": "/public/$1/$2" },
    { "src": "/([^/]+\\.(?:ico|png|jpe?g|gif|svg|webp|txt|xml|mp4|webmanifest|js|css))", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
