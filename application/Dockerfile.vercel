# ==========================================
# STAGE 1: Build Vite frontend
# ==========================================
FROM node:22-alpine AS frontend

WORKDIR /app

COPY package*.json ./

RUN npm install

COPY . .

RUN npm run build


# ==========================================
# STAGE 2: Laravel PHP runtime
# ==========================================
FROM php:8.3-cli

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    unzip \
    curl \
    libzip-dev \
    libonig-dev \
    libxml2-dev \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install \
        opcache \
        pdo_mysql \
        mbstring \
        zip \
        bcmath \
        gd \
    && rm -rf /var/lib/apt/lists/*


# Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer


# ==========================================
# Copy Laravel application
# ==========================================
COPY app ./app
COPY bootstrap ./bootstrap
COPY config ./config
COPY database ./database
COPY public ./public
COPY resources ./resources
COPY routes ./routes
COPY storage ./storage

COPY artisan ./
COPY composer.json ./
COPY composer.lock ./


# ==========================================
# Install PHP dependencies
# ==========================================
RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader


# ==========================================
# Copy compiled Vite assets
# ==========================================
COPY --from=frontend /app/public/build ./public/build


# ==========================================
# Laravel writable directories
# ==========================================
RUN mkdir -p \
    storage/framework/cache \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache


# ==========================================
# Keep the compiled PHP in memory
#
# Without this every request recompiles the
# whole framework from source. Measured on
# the same php -S entrypoint used below, the
# login page went 172ms -> 39ms with it on:
# 4.4x, before touching the database.
#
# The code cannot change inside a built
# image, so there is no reason to keep
# checking the files for edits.
# ==========================================
RUN { \
        echo 'opcache.enable=1'; \
        echo 'opcache.enable_cli=1'; \
        echo 'opcache.validate_timestamps=0'; \
        echo 'opcache.memory_consumption=192'; \
        echo 'opcache.max_accelerated_files=20000'; \
        echo 'opcache.interned_strings_buffer=16'; \
    } > /usr/local/etc/php/conf.d/opcache.ini


# ==========================================
# Precompile Blade views and the route table
#
# Neither reads the environment, so both are
# safe to bake in. (config:cache is NOT --
# it would freeze build-time settings, so it
# runs at start-up instead, below.)
# ==========================================
RUN php artisan view:cache && php artisan route:cache


# ==========================================
# This deployment is the demo
#
# Lists an account per role on the login
# page so the system can be shown without
# handing over nine logins one at a time.
#
# It prints working credentials, so it only
# belongs where the data is invented. If this
# deployment is ever pointed at the real
# shop, delete this line. Setting
# DEMO_LOGINS in the Vercel dashboard
# overrides it either way.
# ==========================================
ENV DEMO_LOGINS=true


# ==========================================
# Start Laravel
#
# IMPORTANT:
# Laravel's server.php expects the current
# working directory to be /app/public.
# Vercel automatically provides $PORT.
# ==========================================
#
# config:cache runs HERE, not at build time: the environment only exists once
# the container starts. Without it Laravel re-reads every config file and parses
# the environment on each request.
#
# migrate runs before serving so the schema matches the code. Without it every
# column added since the database was created is missing and the pages 500.
#
CMD ["sh", "-c", "php /app/artisan config:cache && php /app/artisan migrate --force && cd /app/public && exec php -S 0.0.0.0:${PORT:-80} ../vendor/laravel/framework/src/Illuminate/Foundation/resources/server.php"]
