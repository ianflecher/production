FROM node:22-alpine AS frontend

WORKDIR /app

COPY package*.json ./

RUN npm install

COPY . .

RUN npm run build


FROM php:8.3-cli

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    unzip \
    curl \
    libzip-dev \
    libonig-dev \
    libxml2-dev \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install \
        pdo_mysql \
        mbstring \
        zip \
        bcmath \
        gd \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

COPY app ./app
COPY bootstrap ./bootstrap
COPY config ./config
COPY database ./database
COPY public ./public
COPY resources ./resources
COPY routes ./routes
COPY storage ./storage

COPY artisan ./
COPY composer.json ./
COPY composer.lock ./

RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader

COPY --from=frontend /app/public/build ./public/build

RUN mkdir -p \
    storage/framework/cache \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

# Compile the Blade templates and the route table into the image. Without this
# the first request to every page compiles it on the spot, which is slow and
# needs a writable disk at runtime. Neither step reads the environment, so it
# is safe to bake in (config:cache is NOT — it would freeze build-time env).
RUN php artisan view:cache && php artisan route:cache

# The schema has to match the code before the first request. Nothing ran
# migrations here, so every column added since the database was created was
# missing and each page 500'd on a SQL error. If the database is unreachable
# the container now fails to start, which is louder and easier to diagnose
# than a site that answers 500 to everything.
CMD ["sh", "-c", "exec php -S 0.0.0.0:${PORT} -t public vendor/laravel/framework/src/Illuminate/Foundation/resources/server.php"]
